# ============================================================================
# TRINEXA-AI Backend Environment Configuration
# ============================================================================

# Server Listening Port & Host
PORT=3001
HOST=0.0.0.0

# Database Path (:memory: for volatile test database or a path like ./data/trinexa.sqlite)
DB_PATH=:memory:

# Hardware Connection Timeout in Milliseconds (15 seconds)
# Device is marked OFFLINE if no telemetry is received within this duration
HARDWARE_TIMEOUT_MS=15000

# Optional Device Pre-Shared Key or Token (leave empty for open local development)
DEVICE_AUTH_TOKEN=

