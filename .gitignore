# ============================================================================
# TRINEXA .gitignore
# ============================================================================

# Dependencies & Package Managers
node_modules/
.pnp
.pnp.js
package-lock.json.backup

# Production Builds
dist/
dist-ssr/
build/
*.local

# Environment Variables & Secrets (CRITICAL)
.env
.env.local
.env.development.local
.env.test.local
.env.production.local
firmware/trinexa_esp32/config.h

# Logs & Debugging
logs/
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
lerna-debug.log*

# Database & Storage
*.sqlite
*.sqlite3
*.db
*.db-shm
*.db-wal
data/*.sqlite

# Python & AI Virtual Environments
__pycache__/
*.py[cod]
*$py.class
*.so
.Python
env/
venv/
.venv/
ENV/
env.bak/
venv.bak/
.pytest_cache/
.coverage
htmlcov/
*.egg-info/

# Firmware & Embedded Build Artifacts
.pio/
.vscode/.pio*
*.bin
*.hex
*.elf

# IDE & OS Specific
.DS_Store
Thumbs.db
.idea/
.vscode/*
!.vscode/extensions.json
*.suo
*.ntvs*
*.njsproj
*.sln
*.sw?
